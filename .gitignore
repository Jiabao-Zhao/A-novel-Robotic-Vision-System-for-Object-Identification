# Experiments: source, documentation, small configuration and provenance only.
# Result tables/figures are exact copies under results/ with a source manifest.
/experiments/**
!/experiments/**/
!/experiments/**/*.py
!/experiments/**/*.md
!/experiments/**/*.txt
!/experiments/**/*.yaml
!/experiments/**/*.yml
!/experiments/**/*.toml
!/experiments/**/LICENSE
!/experiments/**/LICENSE.*
!/experiments/**/NOTICE
!/experiments/**/NOTICE.*
!/experiments/**/protocol.json
!/experiments/**/provenance.json
!/experiments/**/evidence.json
!/experiments/**/config.json
!/experiments/**/settings.json

# Downloaded packages, native libraries and model caches are not our source.
/experiments/**/deps/
/experiments/**/sources/
/experiments/**/weights/
/experiments/**/hf_compat/
/experiments/**/hf_compat_failed_install/
/experiments/**/pip_tmp/
/experiments/**/native_libs/
/experiments/**/site-packages/
/experiments/**/__pycache__/
/experiments/**/.pytest_cache/

# Never add model weights, feature banks, pose banks or raw capture arrays.
*.gguf
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.json.gz
*.log
*.zip
*.tar
*.tar.gz
*.7z

